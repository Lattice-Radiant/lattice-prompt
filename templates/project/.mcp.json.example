{
  "_comment": "The four MCP servers of the integrated flow, every one a launcher of the lattice-prompt bundle. The installer registers all four at user scope, so a project needs this file only to pin another bundle or to add a server. Replace <bundle> with the extracted bundle directory; the file is workstation-specific, keep it out of version control. The lattice-radiant launcher merges the timing-closure tools only with TIMING_CLOSURE_MERGE_ENABLED=1 in env, which needs the cortex-framework and cortex-agent-impl packages installed into the bundle's Python.",
  "mcpServers": {
    "arch2code": {
      "command": "<bundle>\bin\u00072c-mcp.cmd",
      "args": []
    },
    "cortex-kb": {
      "command": "<bundle>\bin\\kb-mcp.cmd",
      "args": [
        "--authoring"
      ]
    },
    "lattice-cortex": {
      "command": "<bundle>\bin\\lattice-cortex.cmd",
      "args": []
    },
    "lattice-radiant-mcp": {
      "command": "<bundle>\bin\\lattice-radiant.cmd",
      "args": []
    }
  }
}

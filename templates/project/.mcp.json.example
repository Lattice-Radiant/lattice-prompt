{
  "_comment": "The four MCP servers of the lattice-prompt bundle (lattice-arch2code-mcp, lattice-knowledge-db, lattice-propel-mcp, lattice-radiant-mcp), every one a launcher of the bundle. The bundle's installer registers them at user scope (and removes their old entries: arch2code, cortex-kb, lattice-cortex, lattice-prompt, radiant), so a project needs this file only to pin another bundle or to add a server. Replace <bundle> with the extracted bundle directory; the file is workstation-specific, keep it out of version control.",
  "mcpServers": {
    "lattice-arch2code-mcp": {
      "command": "<bundle>\\bin\\lattice-arch2code-mcp.cmd",
      "args": []
    },
    "lattice-knowledge-db": {
      "command": "<bundle>\\bin\\lattice-knowledge-db.cmd",
      "args": [
        "--authoring"
      ]
    },
    "lattice-propel-mcp": {
      "command": "<bundle>\\bin\\lattice-propel-mcp.cmd",
      "args": []
    },
    "lattice-radiant-mcp": {
      "command": "<bundle>\\bin\\lattice-radiant-mcp.cmd",
      "args": []
    }
  }
}

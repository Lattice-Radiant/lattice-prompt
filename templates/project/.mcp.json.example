{
  "_comment": "The three MCP servers of the lattice-prompt bundle (arch2code, cortex-kb, lattice-cortex), every one a launcher of the bundle, and the lattice-radiant-mcp server from its own installer. The bundle's installer registers its three servers at user scope, so a project needs this file only to pin another bundle or to add a server. Replace <bundle> with the extracted bundle directory and <lattice-radiant-mcp installation> with the virtual environment the Radiant installer created; the file is workstation-specific, keep it out of version control.",
  "mcpServers": {
    "arch2code": {
      "command": "<bundle>\bin\u00072c-mcp.cmd",
      "args": []
    },
    "cortex-kb": {
      "command": "<bundle>\bin\\kb-mcp.cmd",
      "args": [
        "--authoring"
      ]
    },
    "lattice-cortex": {
      "command": "<bundle>\bin\\lattice-cortex.cmd",
      "args": []
    },
    "lattice-radiant-mcp": {
      "command": "<lattice-radiant-mcp installation>\\.venv_lattice-radiant-mcp-1.1.0\\Scripts\\python.exe",
      "args": [
        "-m",
        "radiant_mcp"
      ]
    }
  }
}

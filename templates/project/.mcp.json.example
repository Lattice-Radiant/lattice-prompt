{
  "_comment": "The four MCP servers of the integrated flow, every one a launcher of the lattice-prompt bundle. The installer registers all four at user scope, so a project needs this file only to pin another bundle or to add a server. Replace <bundle> with the extracted bundle directory; the file is workstation-specific, keep it out of version control. The lattice-radiant launcher sets the timing-closure variables itself (internal surface, full tier); set them in env to change the tier.",
  "mcpServers": {
    "arch2code": {
      "command": "<bundle>\bin\u00072c-mcp.cmd",
      "args": []
    },
    "cortex-kb": {
      "command": "<bundle>\bin\\kb-mcp.cmd",
      "args": [
        "--authoring"
      ]
    },
    "lattice-cortex": {
      "command": "<bundle>\bin\\lattice-cortex.cmd",
      "args": []
    },
    "lattice-radiant-mcp": {
      "command": "<bundle>\bin\\lattice-radiant.cmd",
      "args": []
    }
  }
}

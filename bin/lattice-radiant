#!/bin/sh
# The lattice-radiant MCP server (cortex-bridge: Radiant projects and flows, constraints lint,
# programming, Reveal through the revealai plugin) over stdio, from the bundle's Python.
# The timing-closure tools (perceive_timing, propose_levers, ...) come from the separately
# installed cortex-framework and cortex-agent-impl packages, which this bundle does not carry;
# with them installed into the bundle's Python, export TIMING_CLOSURE_MERGE_ENABLED=1 before
# calling and the server merges them (components/cortex-bridge/src is on the module path for
# the merge package; the defaults below select the internal, full-tier tool set).
. "$(dirname "$0")/_env.sh"
export PYTHONPATH="$LP_ROOT/components/cortex-bridge/src${PYTHONPATH:+:$PYTHONPATH}"
: "${CORTEX_TIMING_CLOSURE_MCP_SURFACE:=internal}"
: "${CORTEX_TIMING_CLOSURE_MCP_RELEASE_TIER:=full}"
: "${CORTEX_TIMING_CLOSURE_MCP_ENABLED_TOOLS:=perceive_timing,list_levers,check_plan,search_radiant_docs,propose_levers,get_capability_probe_kit,list_toolchain_capabilities,get_primitive_instantiation_template,list_primitive_topologies,lint_rtl,lint_constraints,verify_non_regression,bind_lever}"
export CORTEX_TIMING_CLOSURE_MCP_SURFACE CORTEX_TIMING_CLOSURE_MCP_RELEASE_TIER CORTEX_TIMING_CLOSURE_MCP_ENABLED_TOOLS
exec "$LP_ROOT/python/bin/python3" -m radiant_mcp "$@"
